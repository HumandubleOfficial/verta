[Plymouth Theme]
Name=Verta
Description=Verta boot animation: the V eases in, the orbit ring spins around it, a soft glow breathes behind
ModuleName=script

[script]
# verta.script draws everything; images are rendered from art/ by
# scripts/render-art.sh (lock.png is copied from the stock theme at build time).
ImageDir=/usr/share/plymouth/themes/verta
ScriptFile=/usr/share/plymouth/themes/verta/verta.script
